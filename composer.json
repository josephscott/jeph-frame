{
	"name": "jeph/frame",
	"license": "MIT",
	"require": {
		"php": ">=8.3",
		"nikic/fast-route": "1.3.0"
	},
	"require-dev": {
		"pestphp/pest": "^4.1.5",
		"josephscott/phpcsfixer-config": "^0.0.6"
	},
	"autoload": {
		"classmap": [
			"src/jeph/frame.php"
		]
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": false
	}
}
